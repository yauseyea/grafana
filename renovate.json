{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended"
  ],
  "baseBranchPatterns": [
    "main"
  ],
  "automerge": false,
  "packageRules": [
    {
      "description": "Automerge",
      "matchDatasources": ["docker"],
      "matchPackageNames": ["grafana/grafana"],
      "matchUpdateTypes": ["minor", "patch", "digest"],
      "automerge": true,
      "automergeType": "branch"
    },
    {
      "description": "Automerge",
      "matchDatasources": ["docker"],
      "matchPackageNames": ["grafana/loki"],
      "matchUpdateTypes": ["minor", "patch", "digest"],
      "automerge": true,
      "automergeType": "branch"
    },
    {
      "description": "Automerge",
      "matchDatasources": ["docker"],
      "matchPackageNames": ["nginx"],
      "matchUpdateTypes": ["minor", "patch", "digest"],
      "automerge": true,
      "automergeType": "branch"
    },
    {
      "description": "Automerge",
      "matchDatasources": ["docker"],
      "matchPackageNames": ["grafana/alloy"],
      "matchUpdateTypes": ["minor", "patch", "digest"],
      "automerge": true,
      "automergeType": "branch"
    },
    {
      "description": "Automerge",
      "matchDatasources": ["docker"],
      "matchPackageNames": ["grafana/tempo"],
      "matchUpdateTypes": ["minor", "patch", "digest"],
      "automerge": true,
      "automergeType": "branch"
    },
    {
      "description": "Automerge",
      "matchDatasources": ["docker"],
      "matchPackageNames": ["grafana/mimir"],
      "matchUpdateTypes": ["minor", "patch", "digest"],
      "automerge": true,
      "automergeType": "branch"
    },
    {
      "description": "Automerge",
      "matchDatasources": ["docker"],
      "matchPackageNames": ["grafana/pyroscope"],
      "matchUpdateTypes": ["minor", "patch", "digest"],
      "automerge": true,
      "automergeType": "branch"
    }
  ]
}
